# CloudOpsAgent local configuration template.
# Copy to .env for local use. Do NOT commit .env and do NOT put real secrets here.

# Simulated application service
APP_SERVICE_PORT=8001
APP_LOG_LEVEL=INFO

# Simulation controls (bounded, local-only). Set APP_SIMULATION_ENABLED=false to
# disable the /simulate/* endpoints outside local development.
APP_SIMULATION_ENABLED=true
APP_SIMULATION_MAX_DURATION_SECONDS=300
APP_SIMULATION_DEFAULT_DURATION_SECONDS=30

# Agent service
AGENT_SERVICE_PORT=8000
AGENT_LOG_LEVEL=INFO
AGENT_APP_BASE_URL=http://app:8001
AGENT_POLL_INTERVAL_SECONDS=10

# Monitoring module (internal to the agent).
AGENT_MONITORING_ENABLED=true
AGENT_TRAFFIC_SPIKE_RPS_THRESHOLD=20.0
AGENT_APP_REQUEST_TIMEOUT_SECONDS=5.0

# LLM provider selection placeholder.
# The provider client is aws bedrock
AGENT_LLM_PROVIDER=aws-bedrock
AWS_REGION=us-east-1
AWS_BEARER_TOKEN_BEDROCK=